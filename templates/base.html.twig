<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: 'en' }}">
	<head>
		{% block head %}
			<meta charset="utf-8"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>
				{% if header.title %}
					{{ header.title }}
				{% endif %}
				{{ site.title }}
			</title>
			{% block stylesheets %}
				{% do assets.addCss('theme://css/custom.css') %}
				{% do assets.addCss('theme://css/styles.css', 99) %}
			{% endblock %}
			{{ assets.css()|raw }}
		{% endblock head %}
	</head>
	<body style="background-color: {{ grav.theme.config.site_background|default('#ffefb8') }};">
		{% block header %}
			<header id="main-header" style="background-color: {{ grav.theme.config.header_background|default('#ffefb8') }};">
				<h1>
					{% if grav.theme.config.custom_logo %}
						{% set logo = grav.theme.config.custom_logo is iterable ? grav.theme.config.custom_logo|first : grav.theme.config.custom_logo %}
						<img src="{{ url('theme://images/' ~ logo.name)|e }}" alt="{{ site.title }}" class="logo-image" />
					{% endif %}
					{{ site.title }}
				</h1>
			</header>
		{% endblock %}
		{% block content %}
			<div id="main-content"></div>
		{% endblock %}
		{% block footer %}
			<footer id="main-footer">
				<div class="wrapper padding">
					<p>{{ grav.theme.config.footer_text|default('&copy; ' ~ "now"|date("Y") ~ ' ' ~ site.title ~ '. All rights reserved.')|raw }}</p>
				</div>
			</footer>
		{% endblock %}
		{% block javascripts %}
			{% do assets.addJs('theme://js/carousel.js', {group: 'bottom'}) %}
			{% do assets.addJs('theme://js/pagescroll.js', {group: 'bottom'}) %}
		{% endblock %}
		{{ assets.js('bottom')|raw }}
	</body>
</html>
