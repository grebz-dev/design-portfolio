{% set images = page.media.images %}
{% set slide_count = images|length %}
{% set theme_color = page.header.color ?: '#a0c2ff' %}
{% set background_color = page.header.bgcolor ?: 'rgba(15,16,24,1)' %}
{% set accent_color = page.header.primary_color ?: theme_color %}
{% set secondary_color = page.header.secondary_color ?: 'rgba(255,255,255,0.65)' %}

<div id="{{ page.slug }}" class="project" data-color="{{ theme_color }}" data-title="{{ page.header.title }}"
	style="--project-bg: {{ background_color }}; --project-accent: {{ accent_color }}; --project-secondary: {{ secondary_color }};">
	{% if slide_count > 1 %}
		{% for image in images %}
			<input type="radio" name="carousel-{{ page.slug }}" id="carousel-{{ page.slug }}-slide-{{ loop.index }}" class="carousel-toggle" {% if loop.first %}checked{% endif %}>
		{% endfor %}
	{% endif %}

	<div class="project-layout">
		<div class="project-gallery">
			{% if slide_count > 0 %}
				<div class="project-gallery-track">
					<!-- Add project details as a carousel item for mobile view -->
					<div class="project-gallery-item project-details-mobile">
						<div class="project-details-content">
							<header class="project-details-header">
								{% if page.header.subtitle %}
									<p class="project-subtitle">{{ page.header.subtitle }}</p>
								{% endif %}
							</header>
							<div class="project-body">
								{{ page.rawMarkdown|markdown|raw }}
							</div>
						</div>
					</div>
					{% for image in images %}
						<figure class="project-gallery-item">
							<img src="{{ image.url }}" alt="{{ image.meta.alt ?: page.header.title ?: page.title }} image {{ loop.index }}">
						</figure>
					{% endfor %}
				</div>
			{% else %}
				<div class="project-gallery-empty">
					<p>No images available for this project.</p>
				</div>
			{% endif %}
		</div>
		<div class="project-details project-details-desktop">
			<header class="project-details-header">
				{% if page.header.subtitle %}
					<p class="project-subtitle">{{ page.header.subtitle }}</p>
				{% endif %}
			</header>
			<div class="project-body">
				{{ page.rawMarkdown|markdown|raw }}
			</div>
		</div>
	</div>
</div>
