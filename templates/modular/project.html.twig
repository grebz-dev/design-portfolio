<div id="{{ page.slug }}" class="section" data-color="{{ page.header.color }}" data-title="{{ page.header.title }}">
	<div class="project-container">
		{# Create a modal for each image #}
		{% for image in page.media.images %}
			<input type="checkbox" id="modal-{{ page.slug }}-{{ loop.index }}">
			<label for="modal-{{ page.slug }}-{{ loop.index }}" class="modal-background"></label>
			<div class="modal">
				<div class="modal-content">
					<div class="modal-header">
						<h2>{{ page.header.title }}</h2>
						<label for="modal-{{ page.slug }}-{{ loop.index }}">
							<img src="data:image/png;base64," width="16" height="16" alt="Close">
						</label>
					</div>
					<img src="{{ image.url }}" alt="{{ image.filename }}">
				</div>
			</div>
		{% endfor %}
		<div class="project-images">
			<div class="carousel">
				<div class="carousel-track">
					{% for image in page.media.images %}
						<label for="modal-{{ page.slug }}-{{ loop.index }}" class="carousel-item">
							<img src="{{ image.url }}" alt="{{ image.filename }}">
						</label>
					{% endfor %}
				</div>
			</div>
		</div>
		<div class="project-content">
			<h2 class="project-title">{{ page.header.title }}</h2>
			<div class="content">
				{{ page.content|raw }}
			</div>
		</div>
	</div>
</div>
