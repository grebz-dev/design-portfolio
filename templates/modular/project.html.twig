<div id="{{ page.slug }}" class="section" data-color="{{ page.header.color }}" data-title="{{ page.header.title }}">
	<div class="project-container">
		<div class="project-images">
			<div class="carousel">
				<div class="carousel-track">
					{% for image in page.media.images %}
						<img src="{{ image.url }}" alt="{{ image.filename }}">
					{% endfor %}
				</div>
			</div>
		</div>
		<div class="project-content">
			<h2 class="project-title">{{ page.header.title }}</h2>
			<div class="content">
				{{ page.content|raw }}
			</div>
		</div>
	</div>
</div>
