{% set content_slides = page.header.items %}
{% set slide_count = content_slides|length %}
{% set project_color = page.header.color ?: '#a0c2ff' %}
{% set background_color = page.header.bgcolor ?: 'rgba(15,16,24,1)' %}

<div id="{{ page.slug }}" class="project" data-color="{{ project_color }}" data-title="{{ page.header.title }}"
	style="--project-bg: {{ background_color }}; --project-accent: {{ project_color }};">
	{% if slide_count > 1 %}
		{% for slide in content_slides %}
			<input type="radio" name="carousel-{{ page.slug }}" id="carousel-{{ page.slug }}-slide-{{ loop.index }}" class="carousel-toggle" {% if loop.first %}checked{% endif %}>
		{% endfor %}
	{% endif %}

	<div class="project-layout">
		<div class="project-gallery">
			{% if slide_count > 0 %}
				<div class="project-gallery-track">
					{% for slide in content_slides %}
						{% if slide.element_selector == 'text' and slide.text.text %}
							<div class="project-gallery-item project-details">
								<div class="project-details-content">
									<div class="project-body">
										{{ slide.text.text|markdown|raw }}
									</div>
								</div>
							</div>
						{% elseif slide.element_selector == 'image' and slide.image.image %}
							{% set image_file = page.media[slide.image.image|first.name] %}
							{% if image_file %}
								{# Create responsive image variants #}
								{% set image_small = image_file.resize(640, 480).quality(80) %}
								{% set image_medium = image_file.resize(1024, 768).quality(82) %}
								{% set image_large = image_file.resize(1920, 1440).quality(82) %}
								{% set image_xlarge = image_file.resize(2560, 1920).quality(85) %}
								
								<figure class="project-gallery-item">
									<img 
										src="{{ image_medium.url }}" 
										srcset="{{ image_small.url }} 640w,
												{{ image_medium.url }} 1024w,
												{{ image_large.url }} 1920w,
												{{ image_xlarge.url }} 2560w"
										sizes="(max-width: 640px) 100vw, 
											   (max-width: 1024px) 90vw,
											   (max-width: 1920px) 85vw,
											   2560px"
										alt="{{ image_file.meta.alt ?: page.header.title ?: page.title }} image {{ loop.index }}"
										loading="lazy"
										decoding="async">
								</figure>
							{% endif %}
						{% elseif slide.element_selector == 'video' and slide.video.video_url %}
							{% set video_url = slide.video.video_url %}
							{% set video_id = null %}
							
							{# Extract YouTube video ID from various URL formats #}
							{% if 'youtube.com/watch' in video_url %}
								{% set video_id = video_url|split('v=')[1]|split('&')[0] %}
							{% elseif 'youtu.be/' in video_url %}
								{% set video_id = video_url|split('youtu.be/')[1]|split('?')[0] %}
							{% elseif 'youtube.com/embed/' in video_url %}
								{% set video_id = video_url|split('embed/')[1]|split('?')[0] %}
							{% endif %}
							
							{% if video_id %}
								<div class="project-gallery-item project-video">
									<div class="grav-youtube">
										<iframe src="https://www.youtube.com/embed/{{ video_id }}?mute=1&rel=0&modestbranding=1" 
											frameborder="0" 
											allowfullscreen
											allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
											loading="lazy">
										</iframe>
									</div>
								</div>
							{% endif %}
						{% endif %}
					{% endfor %}
				</div>
			{% else %}
				<div class="project-gallery-empty">
					<p>No content available for this project.</p>
				</div>
			{% endif %}
		</div>
	</div>
</div>
